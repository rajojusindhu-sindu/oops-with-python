class shape:
    def area(self):
        print("area of the given shape is")
class circle(shape):
    def area(self):
        r=8
        print("area of circle:",3.14*r*r)
class rectangle(shape):
    def area(self):
        l=2
        b=3
        print("area of rectangle:",l*b)
class triangle(shape):
    def area(self):
        base=5
        height=6
        print("area of triangle:",0.5*base*height)
c=circle()
r=rectangle()
t=triangle()
print(c.area())
print(r.area())
print(t.area())
        
